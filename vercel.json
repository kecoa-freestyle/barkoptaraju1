{
  "version": 2,
  "framework": "tanstack-start",
  "builds": [
    {
      "src": ".output/server/index.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/_vinxi/(.*)",
      "dest": "/_vinxi/$1"
    },
    {
      "src": "/(.*)",
      "dest": ".output/server/index.mjs"
    }
  ]
}